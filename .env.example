# Демо-режим: приложение работает без Supabase и без ИИ.
# true — сразу можно смотреть интерфейс на тестовых данных.
# false — нужна настоящая база Supabase.
NEXT_PUBLIC_DEMO_MODE=true

# Адрес сайта. Для локальной работы оставьте как есть.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Эти значения появятся в личном кабинете Supabase:
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Распознавание фото чека. Ключ только на сервере, в браузер он не попадает.
# Пока пусто — приложение подставляет учебный пример и прямо об этом пишет.
# Бесплатный ключ: https://openrouter.ai → Keys. Модель по умолчанию бесплатная.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
